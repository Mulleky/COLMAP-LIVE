# Example configuration for colmap_live.sh
# Edit these paths once, then run:
#   ./colmap_live.sh --config config.env
#
# Or live-watch mode:
#   ./colmap_live.sh --config config.env --watch

# Main paths
WORKSPACE="/home/carlos/colmap_test/sequential"
IMAGE_PATH="/home/carlos/colmap_test/images"

# Optional paths. Leave commented to use defaults inside WORKSPACE.
# DATABASE_PATH="/home/carlos/colmap_test/sequential/database.db"
# LIVE_MODEL_PATH="/home/carlos/colmap_test/sequential/sparse_live"
# OUTPUT_PLY="/home/carlos/colmap_test/sequential/sparse_live.ply"
# PROCESSED_LIST="/home/carlos/colmap_test/sequential/processed_images.txt"
# STATS_JSON="/home/carlos/colmap_test/sequential/pointcloud_log.json"

# COLMAP binary. Usually just "colmap".
COLMAP_BIN="colmap"

# Matching mode:
#   sequential = good for video/drone image sequences
#   exhaustive = okay for small unordered image sets, but slower
MATCHER="sequential"

# Camera settings
# Common values: PINHOLE, SIMPLE_PINHOLE, SIMPLE_RADIAL, OPENCV
CAMERA_MODEL="PINHOLE"

# 1 means all images share one camera/intrinsics.
# This is usually appropriate for frames from the same camera.
SINGLE_CAMERA="1"

# For sequential matching, this controls how many nearby frames get matched.
SEQUENTIAL_OVERLAP="10"

# Bundle adjustment after updates:
#   1 = better quality, slower
#   0 = faster, less refined
RUN_BA="1"

# Export sparse_live.ply after each successful model update:
EXPORT_PLY="1"

# Append one JSON record each time a sparse point cloud/model is generated:
LOG_STATS="1"

# Watch mode settings
WATCH="0"
POLL_SECONDS="3"

# Helps avoid processing an image while it is still being copied into the folder.
WAIT_FOR_STABLE_FILE="1"
STABLE_FILE_SECONDS="1"
